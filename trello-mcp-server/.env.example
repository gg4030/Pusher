# Copy this file to ".env" and fill in real values.
# Never commit your real .env file. .env is already in .gitignore.

# Required: Trello API key and token.
# Get your API key at:    https://trello.com/power-ups/admin (create a Power-Up,
#   then go to "API key").
# Generate a token from that same page by clicking "Token".
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here

# Optional: default board and list IDs.
# Run `python test_trello_connection.py` to discover these IDs.
# If TRELLO_LIST_ID is set, create_trello_card will default to that list.
TRELLO_BOARD_ID=your_default_board_id_here
TRELLO_LIST_ID=your_default_list_id_here

# Optional: log level for the MCP server (DEBUG, INFO, WARNING, ERROR).
TRELLO_MCP_LOG_LEVEL=INFO
